<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is enabled only so the development APK can reach the local XAMPP server. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

