{
  "name": "mangrooves-supabase",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js web/test/*.test.js",
    "build:web": "node scripts/build-web.js",
    "check:edge": "deno check --config functions/api/deno.json functions/api/index.ts",
